@page "/registros"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Estacionamento.MAUI.Models

<h3 class="text-center mb-3">Registros de Estacionamento</h3>

<a href="/registros/create" class="btn btn-primary mb-3">Novo Registro</a>

@if (registros == null)
{
    <p><em>Carregando...</em></p>
}
else if (!registros.Any())
{
    <p><em>Nenhum registro encontrado.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Veículo (Placa)</th>
                <th>Vaga</th>
                <th>Entrada</th>
                <th>Saída</th>
                <th>Valor</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var registro in registros)
            {
                <tr>
                    <td>@registro.Veiculo?.Placa</td>
                    <td>@registro.Vaga?.Localizacao</td>
                    <td>@registro.DataHoraEntrada</td>
                    <td>@registro.DataHoraSaida</td>
                    <td>@registro.ValorFinal?.ToString("C")</td>
                    <td>
                        <a href="registroestacionamento/edit/@registro.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a href="registroestacionamento/details/@registro.Id" class="btn btn-sm btn-info">Detalhes</a>
                    <a href="registroestacionamento/excluir/@registro.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<RegistroEstacionamento> registros;
    protected override async Task OnInitializedAsync()
    {
        registros = await Http.GetFromJsonAsync<List<RegistroEstacionamento>>("https://localhost:4000/api/RegistrosEstacionamento");
     }
   
}
