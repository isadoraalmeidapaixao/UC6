@page "/veiculos/edit/{id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Estacionamento.MAUI.Models

<h3 class="text-center mb-3">Editar Veículo</h3>

@if (false)
{
    <p><em>Carregando...</em></p>
}
else
{
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form >
        <div class="mb-3">
            <label for="placa" class="form-label">Placa</label>
            <InputText id="placa"  class="form-control" />
        </div>
        <div class="mb-3">
            <label for="modelo" class="form-label">Modelo</label>
            <InputText id="modelo"  class="form-control" />
        </div>
        <div class="mb-3">
            <label for="cor" class="form-label">Cor</label>
            <InputText id="cor"  class="form-control" />
        </div>
        <div class="mb-3">
            <label for="motorista" class="form-label">Motorista</label>

        </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                    <a href="/veiculos" class="btn btn-light">Voltar</a>
                </div>
            </form>
        </div>
    </div>
}

@code {



    [Parameter]
    public int Id { get; set; }

    private Veiculo? veiculo;
    protected override async Task OnInitializedAsync()
    {
        veiculo = await Http.GetFromJsonAsync<Veiculo>($"https://localhost:4000/api/Veiculos/{Id}");
    }
    async Task UpdateVeiculo()
    {
        await Http.PutAsJsonAsync($"https://localhost:4000/api/Veiculos/{Id}", veiculo);
        NavigationManager.NavigateTo("/veiculos");
    }

}
