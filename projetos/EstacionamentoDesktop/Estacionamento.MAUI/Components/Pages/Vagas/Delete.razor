@page "/vagas/delete/{Id:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Estacionamento.MAUI.Models

<h3>Excluir Vaga</h3>

@if (vaga == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <h4>Você tem certeza que deseja excluir esta vaga?</h4>
    <div>
        <hr />
        <dl class="row">

            <dt class="col-sm-2">
                Localização
            </dt>
            <dd class="col-sm-10">
                @vaga.Localizacao
            </dd>

        </dl>

        <form @onsubmit="DeleteVaga">
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a href="/vagas" class="btn btn-light">Voltar</a>
        </form>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Vaga vaga = new Vaga();
    protected override async Task OnInitializedAsync()
    {
        vaga = await Http.GetFromJsonAsync<Vaga>($"api/vagas/{Id}");
    }
    private async Task DeleteVaga()
    {
        await Http.DeleteAsync($"api/vagas/{Id}");
        Navigation.NavigateTo("/vagas");
    }
    
}
