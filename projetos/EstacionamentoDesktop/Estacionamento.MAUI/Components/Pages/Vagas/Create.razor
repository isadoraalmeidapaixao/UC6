@page "/vagas/create"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Estacionamento.MAUI.Models

<h3>Criar Vaga</h3>

<hr />

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="CreateVaga">
        <div class="mb-3">
            <label for="placa" class="form-label">Placa</label>
                <InputText id="localizacao" class="form-control" @bind-Value="vaga.Localizacao"  />
        </div>
        <div class="mb-3">
            <label for="modelo" class="form-label">Modelo</label>
                <InputText id="tipovaga" class="form-control" @bind-Value="vaga.TipoVaga" />
        </div>
            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-primary" />
                <a href="/vagas" class="btn btn-light">Voltar</a>
            </div>
        </form>
    </div>
</div>

@code {
    Vaga vaga = new Vaga();

    async Task CreateVaga()
    {
        await Http.PostAsJsonAsync("https://localhost:4000/api/Vagas", vaga);
        NavigationManager.NavigateTo("/vagas");
    }
}
