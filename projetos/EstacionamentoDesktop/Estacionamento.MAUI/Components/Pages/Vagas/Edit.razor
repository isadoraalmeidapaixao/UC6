@page "/vagas/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Estacionamento.MAUI.Models

<h3>Editar Vaga</h3>

@if (vaga== null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <hr />
    <div class="row">
      <div class="col-md-4">
        <form @onsubmit="UpdateVaga">
           <div class="mb-3">
             <label for="localizacao" class="form-label">Localização</label>
             <InputText id="localizacao" @bind-Value="vaga.Localizacao" class="form-control" />
          </div>

          <div class="mb-3">
             <label for="tipo" class="form-label">Tipo da Vaga</label>
             <InputText id="tipo" @bind-Value="vaga.TipoVaga" class="form-control" />
          </div>

          <div class="form-group mt-3">
             <input type="submit" value="Salvar" class="btn btn-primary" />
             <a href="/vagas" class="btn btn-light">Voltar</a>
          </div>
        </form>
      </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Vaga? vaga;

    protected override async Task OnInitializedAsync()
    {
        vaga = await Http.GetFromJsonAsync<Vaga>($"https://localhost:4000/api/Vagas/{Id}");
    }

    async Task UpdateVaga()
    {
        await Http.PutAsJsonAsync($"https://localhost:4000/api/Vagas/{Id}", vaga);
        NavigationManager.NavigateTo("/vagas");
    }

}
