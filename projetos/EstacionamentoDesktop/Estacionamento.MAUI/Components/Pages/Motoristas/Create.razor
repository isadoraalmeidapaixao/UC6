@page "/motoristas/create"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Estacionamento.MAUI.Models

<h3 class="text-center mb-3">Novo Motorista</h3>
<hr />

<div class="row">
    <div class="col-md-4">
        <form @onsubmit="CreateMotorista">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome</label>
                <InputText id="nome" class="form-control" @bind-Value="motorista.Nome" />
            </div>

            <div class="mb-3">
                <label for="cpf" class="form-label">CPF</label>
                <InputText id="cpf" class="form-control" @bind-Value="motorista.Cpf" />
            </div>

            <div class="mb-3">
                <label for="telefone" class="form-label">Telefone</label>
                <InputText id="telefone" class="form-control" @bind-Value="motorista.Telefone" />
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/motoristas" class="btn btn-light">Voltar</a>
            </div>
        </form>

    </div>
</div>

@code {

    Motorista motorista = new Motorista();
    List<Veiculo>? veiculos;

    protected override async Task OnInitializedAsync()
    {
        veiculos = await Http.GetFromJsonAsync<List<Veiculo>>("https://localhost:4000/api/Veiculos");
    }

    async Task CreateMotorista()
    {
        await Http.PostAsJsonAsync("https://localhost:4000/api/Motoristas", motorista);
        NavigationManager.NavigateTo("/motoristas");
    }
}
